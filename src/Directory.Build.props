<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <LangVersion>latest</LangVersion>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' or '$(Configuration)' == 'Release'">true</ContinuousIntegrationBuild>
    <Version>0.2.1-alpha</Version>
    <Company>OpenCIFS Contributors</Company>
    <Authors>OpenCIFS Contributors</Authors>
    <Copyright>Copyright (c) 2026 OpenCIFS Contributors</Copyright>
    <RepositoryUrl>https://github.com/jchristn/OpenCIFS</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PackageProjectUrl>https://github.com/jchristn/OpenCIFS</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReleaseNotes>0.2.1-alpha: dependency refresh with no public API or behavior changes. The packages now build against System.IO.Pipelines 10.0.12 (from 10.0.11); test and tooling dependencies were updated (Touchstone 0.2.0, NUnit 5.0.0, xUnit v3 4.0.1, Microsoft.NET.Test.Sdk 18.10.1, Microsoft.Testing.Platform 2.4.1). See https://github.com/jchristn/OpenCIFS/blob/main/CHANGELOG.md.</PackageReleaseNotes>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)..\LICENSE.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
