<Project>
  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'OpenCIFS.Protocol' or '$(MSBuildProjectName)' == 'OpenCIFS.Transport' or '$(MSBuildProjectName)' == 'OpenCIFS.Security' or '$(MSBuildProjectName)' == 'OpenCIFS.Server' or '$(MSBuildProjectName)' == 'OpenCIFS.Client'">
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>OpenCIFS.Test.Shared</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>OpenCIFS.Test.Automated</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>OpenCIFS.Test.Xunit</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>OpenCIFS.Test.Nunit</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' == 'OpenCIFS.Protocol'">
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>OpenCIFS.Client</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>OpenCIFS.Server</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <Target
    Name="OpenCifsValidateCoverageMatrix"
    AfterTargets="Build"
    Condition="'$(MSBuildProjectName)' == 'Sample.OpenCifsServer' and '$(IsCrossTargetingBuild)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(SkipOpenCifsCoverageValidation)' != 'true'">
    <Exec Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)..\eng\OpenCIFS.Build\OpenCIFS.Build.csproj&quot; --configuration $(Configuration) --no-launch-profile -- validate-coverage &quot;$(MSBuildThisFileDirectory)..\docs\coverage-matrix.md&quot;" />
  </Target>

  <Target
    Name="OpenCifsValidatePackageGraph"
    AfterTargets="Build"
    Condition="'$(MSBuildProjectName)' == 'Sample.OpenCifsServer' and '$(IsCrossTargetingBuild)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(SkipOpenCifsPackageGraphValidation)' != 'true'">
    <Exec Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)..\eng\OpenCIFS.Build\OpenCIFS.Build.csproj&quot; --configuration $(Configuration) --no-launch-profile -- validate-package-graph &quot;$(MSBuildThisFileDirectory)..\src&quot;" />
  </Target>

  <Target
    Name="OpenCifsValidatePackageClaims"
    AfterTargets="Build"
    Condition="'$(MSBuildProjectName)' == 'Sample.OpenCifsServer' and '$(IsCrossTargetingBuild)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(SkipOpenCifsPackageClaimValidation)' != 'true'">
    <Exec Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)..\eng\OpenCIFS.Build\OpenCIFS.Build.csproj&quot; --configuration $(Configuration) --no-launch-profile -- validate-package-claims &quot;$(MSBuildThisFileDirectory)..&quot;" />
  </Target>

  <Target
    Name="OpenCifsValidateInteropMatrix"
    AfterTargets="Build"
    Condition="'$(MSBuildProjectName)' == 'Sample.OpenCifsServer' and '$(IsCrossTargetingBuild)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(SkipOpenCifsInteropValidation)' != 'true'">
    <Exec Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)..\eng\OpenCIFS.Build\OpenCIFS.Build.csproj&quot; --configuration $(Configuration) --no-launch-profile -- validate-interop &quot;$(MSBuildThisFileDirectory)..\docs\interop-matrix.md&quot;" />
  </Target>

  <Target
    Name="OpenCifsValidateSourceAudit"
    AfterTargets="Build"
    Condition="'$(MSBuildProjectName)' == 'Sample.OpenCifsServer' and '$(IsCrossTargetingBuild)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(SkipOpenCifsSourceAuditValidation)' != 'true'">
    <Exec Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)..\eng\OpenCIFS.Build\OpenCIFS.Build.csproj&quot; --configuration $(Configuration) --no-launch-profile -- validate-source-audit &quot;$(MSBuildThisFileDirectory)..&quot;" />
  </Target>
</Project>
